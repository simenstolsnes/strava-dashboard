# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=116361
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it back when the webhook is registered
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Only this Strava athlete may log in (your athlete id)
OWNER_ATHLETE_ID=13512831

# Supabase (Project Settings → API). The service role key stays server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign the login cookie (32+ chars)
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Vercel sends this as a Bearer token to the daily cron job
CRON_SECRET=

# Garmin Connect Personal API key (Garmin Connect → Settings → Personal API).
# Optional: powers the Recovery page. Keys expire (max 1 year); Garmin emails before.
GARMIN_PERSONAL_API_KEY=

# Friends (optional): they log in to their own dashboard and appear on Compare.
# Short lowercase keys, comma-separated, e.g. FRIENDS=ola. Then, for each key:
FRIENDS=
# FRIEND_OLA_ATHLETE_ID=            their Strava athlete id (the number in strava.com/athletes/<id>)
# Optional: THEIR own Strava API app. Leave out to let them log in through yours
# (needs room in your app's athlete capacity at strava.com/settings/api).
# FRIEND_OLA_STRAVA_CLIENT_ID=
# FRIEND_OLA_STRAVA_CLIENT_SECRET=
# FRIEND_OLA_GARMIN_API_KEY=        optional: their Garmin Connect Personal API key
